      "args": {
        "commands": [
          "bash /usr/local/factory/sh/confirm_15w_6w.sh"
        ]
      }
    },
    "AudioJack": {
      "args": {
        "check_cras": false,
        "require_dongle": true,
        "check_dongle": true,
        "initial_actions": [
          [
            "sof-hda-dsp",
            null
          ]
        ],
        "input_dev": [
          "sof-hda-dsp",
          "0"
        ],
        "mic_source": "Extmic",
        "output_dev": [
          "sof-hda-dsp",
          "0"
        ],
        "output_volume": 10,
        "tests_to_conduct": [
          {
            "freq_threshold": 300,
            "rms_threshold": [
              0.08,
              null
            ],
            "type": "sinewav"
          }
        ]
      }
    },
    "SpeakerDMic": {
      "args": {
        "autostart": true,
        "check_dongle": true,
        "initial_actions": [
          [
            "sof-hda-dsp",
            null
          ]
        ],
        "input_dev": [
          "sof-hda-dsp",
          "Dmic"
        ],
        "mic_source": "Dmic",
        "output_dev": [
          "sof-hda-dsp",
          "Speaker"
        ],
        "output_volume": 10,
        "require_dongle": false,
        "tests_to_conduct": [
          {
            "input_channels": [0,1],
            "threshold": 80,
            "type": "audiofun",
            "volume_gain": 30
          }
        ]
      }
    },
    "LEDBattery": {
      "label": "Test Battery LED",
      "pytest_name": "led",
      "args": {
        "challenge": true,
        "target_leds": ["BATTERY"],
        "colors": [
          ["BATTERY", "AMBER"],
          ["BATTERY", "WHITE"],
          ["BATTERY", "OFF"]
        ]
      }
    },
