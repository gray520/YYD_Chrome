        "sync_event_logs": false,
        "sync_time": true,
        "update_toolkit": false,
        "upload_report": false,
        "upload_reg_codes": true,
        "flush_testlog": false
      }
    },
    "CheckRegCodeForSMT": {
      "run_if": "device.component.is_spare_part",
      "pytest_name": "check_regcode",
      "label": "Check RegCode"
    },
    "CheckBoardID": {
      "run_if": "device.component.is_spare_part",
      "pytest_name": "board_id_check",
      "label": "Check Board_ID"
    },
    "SMTCheckMem": {
      "pytest_name": "smt_hardware_check",
      "label": "Check Memory Size",
      "args": {
        "check_cpu_model": false,
        "check_memory_size": true,
        "check_lcd_pid": false,
        "check_storage_size": false,
        "check_display_type": false
      }
    },
