  "definitions": {
    "SMTComponents": {
      "subtests": [
        "ProbeBluetooth",
        "SMTWifiSSIDList",
        "Battery",
        "SMTStressAppTest",
        "SMTStressCountdown",
        "ChargerTypeDetection",
        "PartitionTable",
        "VerifyRootPartition"
      ]
    },
    "SMT": {
      "label": "SMT (Kaladin SMT Functions Test)",
      "locals": {
        "station_num": "SMT",
        "station_end_upload_report": true
      },
      "subtests": [
        "Start",
        "Barrier",
        "SMTStart",
        "SMTItems",
        "CheckPoint",
        "SMTEnd"
      ]
    },
    "SMTStart": {
      "inherit": "TestGroup",
      "label": "Prepare",
      "subtests": [
        "ECWPPinHigh",
        "Partitions2Protect",
        "WaitTi50",
        "UpdateTi50Firmware",
        "Barrier",
        "ReadDeviceDataFromVPD",
        "SMTScanMLB",
        "SMTScanOperatorID",
        "SMTScanStationID",
        "SetOEMName",
        "StationStart",
        "SMTDefineTestConfig",
        "ModelSKU",
        "CheckHaveFanOrNot",
        "SMTDefineTestConfig",
        "WriteDeviceDataToVPD",
        "Barrier"
      ]
    },
    "SMTItems": {
      "inherit": "TestGroup",
      "subtests": [
        "OnboardWifiFalse",
        "WifiSSIDListForSMT",
        "CheckStorageSMT",
        "SMTCheckMem",
        "ThermalSensors",
        "Bluetooth",
        "SMTThermalLoad",
        "SMTKaladinProbe",
        "CheckSecdataVersion",
        "SMTComponents",
        "SpeakerDMic",
        "KeyboardPowerButton",
        "FrontCamera",
        "LEDBattery",
        "LidSwitch",
        "SMTKeyboard",
        "KeyboardBacklight",
        "Touchpad",
        "AudioJack",
        "KaladinFan",
        "USBTypeAManualBase",
        "USBTypeCManualTestGroup",
        "USBTypeCManualChargeGroup"
      ]
    },
    "SMTEnd": {
      "inherit": "TestGroup",
      "label": "Finish",
      "subtests": [
        "SMTUploadRegCodes",
        "CheckBoardID",
        "SMTStationEnd",
        "DeleteSMTENDFlags",
        "CheckPoint",
        "KaladinFlashNetBIOS",
        "ClearTPMRequest",
        "ShutdownClearSMTData",
        "CheckPoint",
        "HaltStep"
      ]
    },
    "SMTStationEnd": {
      "inherit": "FlattenGroup",
      "subtests": [
        {
          "inherit": "SyncFactoryServerUploadReport",
          "args": {
            "report_serial_number_name": "serials.mlb_serial_number"
          }
        },
        "ShopfloorNotifyEnd",
        "Barrier",
        "WriteDeviceDataToVPD"
      ]
    },
    "StationStart": {
      "inherit": "FlattenGroup",
      "subtests": [
        "SyncFactoryServer",
        "Barrier",
        "ShopfloorNotifyStart"
      ]
    },
    "ShopfloorService": {
      "pytest_name": "shopfloor_service",
      "run_if": "constants.enable_factory_server"
    },
    "HardwareTest": {
      "parallel": true,
      "subtests": [
        "PartitionTable",
        "VerifyRootPartition",
        "BatterySysfs",
        "Battery",
        "ThermalSensors",
        "MemorySize"
      ]
    },
    "StationEnd": {
      "inherit": "FlattenGroup",
      "subtests": [
        "StationEndSyncFactoryServer",
        "ShopfloorNotifyEnd",
        "Barrier",
        "WriteDeviceDataToVPD"
      ]
    },
    "ProbeBluetooth": {
      "inherit": "ExecShell",
      "label": "Probe Bluetooth",
      "args": {
        "commands": "lshw | grep -i Bluetooth"
      }
    },
    "UpdateCBI": {
      "pytest_name": "update_cbi",
      "label": "Update CBI",
      "args": {
        "enable_factory_server": false,
        "force": true,
        "program": "nissa",
        "project": "kaladin",
        "cbi_data_names": [
          "SKU_ID",
          "DRAM_PART_NUM"
        ]
      }
    },
    "LidSwitch": {
      "pytest_name": "lid_switch",
      "label": "Lid Switch",
      "args": {
        "timeout_secs": "eval! constants.default_timeout_secs",
	"device_filter": "Lid Switch"
      }
    },
    "KeyboardPowerButton": {
      "subtests": [
        {
          "inherit": "Button",
          "label": "Power Button",
          "args": {
            "button_key_name": "ectool:-GSC_EC_PWR_BTN_ODL",
            "button_name": "i18n! Power Button"
          }
        }
      ]
    },
    "Keyboard": {
      "args": {
        "timeout_secs": "eval! constants.default_timeout_secs",
        "has_numpad": false,
        "allow_multi_keys": true,
        "has_power_key": true,
        "fn_keycodes": [
         1,158,173,372,120,99,224,225,586,164,248,113,114,115
        ],
        "skip_keycodes": [
          116,583 
        ]
      }
    },
    "KeyboardBacklight": {
      "pytest_name": "keyboard_backlight"
    },
    "ECWPPinHigh": {
      "inherit": "ExecShell",
      "label": "EC WP Pin High",
      "args": {
        "commands": [
          "ectool gpioget EC_WP_ODL | tr ' ' '_' | grep GPIO_EC_WP_ODL_=_1"
        ]
      }
    },
    "Bluetooth": {
      "args": {
        "prompt_scan_message": false
      }
    },
    "Wireless": {
      "args": {
        "device_name": "wlan0",
        "services": [
          [
            "hap80211D",
            2437,
            null
          ]
        ],
        "strength": {
          "main": -65,
          "aux": -65,
          "all": -65
        },
        "connect_timeout": 40,
        "press_space_to_start": false,
        "wifi_chip_type": "radiotap",
        "scan_count": 1
      }
    },
    "Delay30S": {
      "pytest_name": "exec_shell",
      "label": "Delay30S",
      "args": {
        "commands": [
          "sleep 30"
        ]
      }
    },
    "WaitTi50": {
      "pytest_name": "exec_shell",
      "label": "Wait for Ti50 Ready",
      "args": {
        "commands": [
          "while true; do if [ $(cat /proc/uptime |awk -F'.' '{print $1}') -lt 60 ]; then echo wait; sleep 5; else break; fi; done"
        ]
      }
    },
    "Fan": {
      "run_if": "device.component.has_fan",
      "args": {
        "probe_interval_secs": 0.2,
        "target_rpm": [
          2600,
          3000,
          3800
        ],
        "error_margin": 300
      }
    },
    "UpdateCBIGroup": {
      "subtests": [
        "SetCBIToDefault",
        "Barrier",
        "UpdateCBI",
        "Barrier",
        "FullRebootStep"
      ]
    },
    "SetCBIToDefault": {
      "inherit": "ExecShell",
      "label": "Set CBI To Default",
      "args": {
        "commands": [
          "ectool cbi set 2 0x7fffffff 4; ectool cbi remove 6"
        ]
      }
    },
    "SetOEMName": {
      "pytest_name": "exec_shell",
      "label": "SetOEMName (*)",
      "args": {
        "commands": [
          "ectool cbi set 4 HP 0",
          "factory device-data oem_name=HP"
        ]
      }
    },
    "FrontCamera": {
      "inherit": "Camera",
      "label": "Front Camera",
      "args": {
        "mode": "manual",
        "num_frames_to_pass": 1,
        "camera_facing": "front"
      }
    },
    "Touchscreen": {
      "__replace__": true,
      "run_if": "device.component.has_touchscreen",
      "pytest_name": "touchscreen",
      "args": {
        "x_segments": 7,
        "y_segments": 7
      }
    },
    "Touchpad": {
      "args": {
        "number_to_quadrant": 0,
        "number_to_click": 0,
        "x_segments": 3,
        "y_segments": 3,
        "timeout_secs": 200
      }
    },
    "BadBlocks": {
      "run_if": "not device.factory.my_ufs"
    },
    "USBTypeAManualTest": {
      "inherit": "FlattenGroup",
      "subtests": [
        "USBTypeAManualTest1"
      ]
    },
    "UpdateDeviceDataFromComponents": {
      "pytest_name": "update_device_data_from_components",
      "args": {
        "wlan_mac": true,
        "bt_mac": true
      }
    },
    "USBTypeCManualTestGroup": {
      "inherit": "FlattenGroup",
      "subtests": [
        "USBTypeCManualUSB",
        "USBTypeCManualDisplay"
      ]
    },
