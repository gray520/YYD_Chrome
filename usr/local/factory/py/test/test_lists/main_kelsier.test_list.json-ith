          "args": {
            "commands": "bash /usr/local/factory/sh/debug_reboot.sh Pre_Oper warmreboot"
          }
        },
        {
          "inherit": "RebootStep",
          "label": "Do-Reboot",
          "args": {
            "warmup_post_shutdown": "eval! constants.run_in.reboot_warmup_secs"
          }
        },
        {
          "inherit": "ExecShell",
          "label": "WarmReboot (SH_Post-Operation)",
          "args": {
            "commands": "bash /usr/local/factory/sh/debug_reboot.sh Post_Oper warmreboot"
          }
        }
      ]
    },
