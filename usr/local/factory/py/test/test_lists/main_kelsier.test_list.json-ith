    "AudioJack": {
      "args": {
        "check_cras": false,
        "require_dongle": true,
        "check_dongle": true,
        "initial_actions": [
          [
            "sof-hda-dsp",
            null
          ]
        ],
        "input_dev": [
          "sof-hda-dsp",
          "0"
        ],
        "mic_source": "Extmic",
        "output_dev": [
          "sof-hda-dsp",
          "0"
        ],
        "output_volume": 10,
        "tests_to_conduct": [
          {
            "freq_threshold": 300,
            "rms_threshold": [
              0.08,
              null
            ],
            "type": "sinewav"
          }
        ]
      }
    },
    "SpeakerDMic": {
      "args": {
        "autostart": true,
