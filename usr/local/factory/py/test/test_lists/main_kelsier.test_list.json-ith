    "SettingCBIFromSF": {
      "inherit": "ExecShell",
      "label": "Setting CBI From SF",
      "args": {
        "commands": [
          "ectool cbi set 2 `factory device-data -g component.sku` 4"
        ]
      }
    },
    "CheckReleaseImage": {
      "pytest_name": "check_image_version",
      "label": "Check Release Image",
      "args": {
        "require_space": false,
        "check_release_image": true,
        "min_version": "eval! constants.release_version",
        "reimage": false,
        "use_netboot": false
      }
    },
    "Ti50APROVerification": {
      "inherit": "TestGroup",
      "label": "Ti50 AP RO Verification",
      "subtests": [
        {
          "pytest_name": "ti50_ap_ro_verification",
          "run_if": "constants.phase == 'PVT'",
          "label": "Ti50 AP RO Verification (PVT)",
          "allow_reboot": true,
          "args": {
            "enable_swwp": true,
            "two_stages": "eval! constants.factory_process == 'TWOSTAGES'"
          }
        },
        {
          "pytest_name": "ti50_ap_ro_verification",
          "label": "Ti50 AP RO Verification (pre-PVT)",
          "run_if": "constants.phase != 'PVT'",
          "allow_reboot": true,
          "args": {
            "enable_swwp": false,
            "two_stages": "eval! constants.factory_process == 'TWOSTAGES'"
          }
        }
      ]
    },
    "CBXBrandedChassis": {
      "run_if": "device.component.cbx",
      "pytest_name": "cbx_branded_chassis",
      "args": {
        "rma_mode": "eval! constants.factory_process == 'RMA'"
      }
    },
    "NoCBXBrandedChassis": {
      "run_if": "not device.component.cbx",
      "pytest_name": "no_cbx_branded_chassis",
      "args": {
        "rma_mode": "eval! constants.factory_process == 'RMA'"
      }
    },
    "CopyChromeosConfig": {
      "run_if": "device.component.cpu_n355",
      "pytest_name": "exec_shell",
      "label": "Copy Chromeos Config",
      "args": {
        "commands": [
          "cp /usr/local/factory/sh/chromeos-config/configfs.img /usr/share/chromeos-config",
          "cp /usr/local/factory/sh/chromeos-config/identity.bin /usr/share/chromeos-config",
          "cp /usr/local/factory/sh/chromeos-config/yaml/config.yaml /usr/share/chromeos-config/yaml/config.yaml",
          "cp /usr/local/factory/sh/chromeos-config/yaml/project-config.json /usr/share/chromeos-config/yaml/project-config.json",
          "sync",
          "sudo chmod 777 -R /usr/share/chromeos-config"
        ]
      }
    },
    "KelsierCustomerTag": {
      "run_if": "device.component.cbx",
      "pytest_name": "exec_shell",
      "label": "Write CBX Tag For Kaladin",
      "args": {
        "commands": [
          "vpd -s custom_label_tag=kelsier_cbx"
        ]
      }
    },
    "GetDUTInfo": {
      "pytest_name": "exec_shell",
      "label": "Get DUT Info",
      "args": {
        "commands": [
          "bash /usr/local/factory/sh/get_dut_info.sh"
        ]
      }
    },
    "CopyIntelWiFiSar": {
      "run_if": "device.component.intel_wireless",
      "pytest_name": "exec_shell",
      "label": "Check WiFi Intel Sar Table",
      "args": {
        "commands": [
          "cp /usr/local/factory/sh/iwlwifi.conf /etc/modprobe.d/",
          "sync",
          "sleep 2"
        ]
      }
    },
    "CheckIntelWiFiSar": {
      "run_if": "device.component.intel_wireless",
      "pytest_name": "exec_shell",
      "label": "Check WiFi Intel Sar Table",
      "args": {
        "commands": [
          "bash /usr/local/factory/sh/check_iwlwifi_0826.sh"
        ]
      }
    },
    "GetBatteryCT": {
      "pytest_name": "exec_shell",
      "label": "Get Battery CT Value",
      "args": {
        "commands": [
          "bash /usr/local/factory/sh/get_battery_ct.sh"
        ]
      }
    },
    "CheckBatteryCapacity": {
      "pytest_name": "exec_shell",
      "label": "Check Battery Capacity",
      "args": {
        "commands": [
          "bash /usr/local/factory/sh/battery_capacity.sh"
        ]
      }
    },
    "ThemalTestGroup": {
      "retries": 3,
      "label": "HP Request Thermal Test",
      "subtests": [
        "Confirm15Wor6W",
        "HPRequestThermalTestInstall",
        "HPRequestThermalTestCreatePath",
        "HPRequestSetFanRPM",
        "HPRequestThermalTest",
        "HPRequestThermalTestCopyLog",
        "CheckPTATLog",
        "RebootStep"
      ]
    },
    "ThemalTestWithWEBGLGroup": {
      "retries": 3,
      "label": "HP Request Thermal With WebGL Test",
      "subtests": [
        "Confirm15Wor6W",
        "HPRequestThermalTestInstall",
        "HPRequestThermalTestCreatePath",
        "HPRequestSetFanRPM",
        "HPRequestThermalTestGroup1000",
        "HPRequestThermalTestCopyLog",
        "CheckPTATLog",
        "RebootStep"
      ]
    },
    "KelsierCopyManifestToCME": {
      "pytest_name": "exec_shell",
      "label": "Kelsier Copy Manifest to CME",
      "args": {
        "commands": [
          "mkdir /usr/local/cme -p",
          "mkdir /usr/local/cme/ish -p",
          "mkdir /usr/local/factory/cme -p",
          "mkdir /usr/local/factory/cme/ish -p",
          "cp /usr/local/factory/sh/component_manifest.json /usr/local/cme/component_manifest.json -rf",
          "cp /usr/local/factory/sh/component_manifest.json /usr/local/factory/cme/component_manifest.json -rf",
          "cp /usr/local/factory/sh/component_manifest_lite.json /usr/local/cme/ish/component_manifest.json -rf",
          "cp /usr/local/factory/sh/component_manifest_lite.json /usr/local/factory/cme/ish/component_manifest.json -rf"
        ]
      }
    },
    "IgnoreLTRCNV": {
      "pytest_name": "exec_shell",
      "label": "Ignore LTR CNV",
      "args": {
        "commands": [
          "bash /usr/local/factory/sh/ignore_ltr_cnv.sh"
        ]
      }
    },
    "UpdateTi50Firmware": {
      "inherit": "TestGroup",
      "label": "Update Ti50 Firmware",
      "subtests": [
        {
          "pytest_name": "update_cr50_firmware",
          "label": "Update Ti50 Firmware",
          "args": {
            "from_release": true
          }
        },
        {
          "inherit": "RebootStep",
          "run_if": "device.factory.cr50_update_need_reboot"
        },
        "CheckTi50FirmwareVersion",
        "ClearInactiveTi50Slot"
      ]
    },
    "RunInPass": {
      "pytest_name": "message",
      "label": "RunIn Test Pass",
      "args": {
        "manual_check": true,
        "background_color": "green",
        "html": "i18n! <b> RunIn PASS </b>"
      }
    },
    "CheckACState": {
      "pytest_name": "exec_shell",
      "label": "Check AC State",
      "args": {
        "commands": [
          "bash /usr/local/factory/sh/check_ac.sh"
        ]
      }
    },
    "WriteEmptyMLBSN": {
      "pytest_name": "exec_shell",
      "label": "Write Empty MLB SN",
      "args": {
        "commands": [
          "factory device-data serials.mlb_serial_number="
        ]
      }
    },
    "DeletePVTDLMSKUID": {
      "pytest_name": "exec_shell",
      "label": "Delete PVT DLM SKU ID",
      "args": {
        "commands": [
          "vpd -i RO_VPD -d dlm_sku_id | true"
        ]
      }
    },
    "CopyManifestFromRelease": {
      "pytest_name": "exec_shell",
      "label": "Copy Manifest From Release",
      "args": {
        "commands": [
          "bash /usr/local/factory/sh/copy_manifest_from_release.sh"
        ]
      }
    },
    "CopyGSCTool": {
      "pytest_name": "exec_shell",
      "label": "Copy gsctool to Sbin",
      "args": {
        "commands": [
          "cp -rf /usr/local/factory/sh/gsctool /usr/sbin/"
        ]
      }
    },
    "Phiyo1port": {
      "retries": 2,
      "pytest_name": "exec_shell",
      "run_if": "device.component.has_mother_board_usb_c==1",
      "label": "Type C Phiyo 1 Port",
      "args": {
        "commands": [
          "bash /usr/local/factory/sh/phiyo1/run.sh"
        ]
      }
    },
    "Phiyo2port": {
      "retries": 2,
      "pytest_name": "exec_shell",
      "run_if": "device.component.has_mother_board_usb_c==2",
      "label": "Type C Phiyo 2 Port",
      "args": {
        "commands": [
          "bash /usr/local/factory/sh/phiyo2/run.sh"
        ]
      }
    },
    "FATP": {
      "subtests": [
        "FAT",
        "FFT",
        "RunIn",
        "GRT"
      ]
    }
  },
  "tests": [
    "FATP"
  ]
}
