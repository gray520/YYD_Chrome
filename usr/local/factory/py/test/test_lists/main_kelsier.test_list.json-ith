    "Wireless": {
      "__comment": "AP setting for Wireless test. 2.4G uses channels 1(2412), 4(2427), 8(2447). 5G uses channels 149(5745), 153(5765), 157(5785).",
      "retries": 5,
      "args": {
        "press_space_to_start": false,
        "ignore_missing_services": true,
        "device_name": "wlan0",
        "services": [
          [
            "hap80211BChrome",
            null,
            null
          ],
          [
            "hap80211A",
            null,
            null
          ],
          [
            "HP_D_24G",
            null,
            null
          ],
          [
            "HP_D_5G",
            null,
            null
          ],
          [
            "hap80211B",
            null,
            null
          ],
          [
            "hap80211C",
            null,
            null
          ],
          [
            "hap80211D",
            null,
            null
          ],
          [
            "Inventec-RD",
            null,
            "BU3Rd+1234562025a."
          ],
          [
            "hap80211E",
            null,
            null
          ],
          [
            "hap80211F",
            null,
            null
          ],
          [
            "hap80211G",
            null,
            null
          ]
        ],
        "strength": {
          "main": -65,
          "aux": -65,
          "all": -65
        },
        "switch_antenna_config": {
          "main": [
            1,
            3
          ],
          "aux": [
            2,
            3
          ],
          "all": [
            3,
            3
          ]
        },
        "keep_monitor": true,
        "scan_count": 10
      }
