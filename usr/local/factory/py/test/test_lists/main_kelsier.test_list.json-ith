{
  "inherit": [
    "common.test_list",
    "generic_main.test_list"
  ],
  "label": "Kelsier Main Test-List 20260414",
  "constants": {
    "phase": "PVT",
    "release_version": "16437.0.0",
    "run_in": {
      "sat_duration_secs": 1800,
      "run_fishes_for_secs": 1800,
      "dozing_sat_duration_secs": 600,
      "reboot_warmup_secs": 30
    },
    "default_factory_server_url": {
      "172.0.0.0/8": "http://172.150.128.11:10080",
      "172.0.0.0/8": "http://172.150.128.12:10080"
    },
    "default_timeout_secs": 99999999,
    "typea_usb": {
      "usb": {
        "usb2_sysfs_path": "/sys/devices/pci0000:00/0000:00:14.0/usb3/3-3/",
        "usb3_sysfs_path": "/sys/devices/pci0000:00/0000:00:14.0/usb4/4-1/"
      }
    },
    "typec_usb": {
      "left": {
        "usb2_sysfs_path": "/sys/devices/pci0000:00/0000:00:14.0/usb3/3-1/",
        "usb3_sysfs_path": "/sys/devices/pci0000:00/0000:00:0d.0/usb2/2-1/",
        "usbpd_id": 0,
        "drm_sysfs_path": "/sys/class/drm/card0",
        "display_info": {
          "display_label": "DisplayPort",
          "display_id": "DP-1",
          "usbpd_spec": {
            "port": 0
          }
        }
      },
      "right": {
        "usb2_sysfs_path": "/sys/devices/pci0000:00/0000:00:14.0/usb3/3-2/",
        "usb3_sysfs_path": "/sys/devices/pci0000:00/0000:00:0d.0/usb2/2-2/",
        "usbpd_id": 1,
        "drm_sysfs_path": "/sys/class/drm/card0",
        "display_info": {
          "display_label": "DisplayPort",
          "display_id": "DP-2",
          "usbpd_spec": {
            "port": 1
          }
        }
      }
    },
    "smt": {
      "component_list": [
        "audio_codec",
        "battery",
        "camera",
        "cpu",
        "base_accel",
        "flash_chip",
        "embedded_controller",
        "storage",
        "usb_hosts",
        "wireless",
        "bluetooth",
        "touchscreen",
        "touchpad"
      ]
    },
    "grt": {
      "enable_zero_touch": true,
      "collect_zero_touch_ids": true,
      "gooftool_skip_list": []
    }
  },
  "options": {
    "ui_locale": "en-US",
    "engineering_password_sha1": "6848bf3617a2cf82bd5260a146d4a3236a20badc",
    "skipped_tests": {
      "device.factory.end_FAT": [],
      "device.factory.end_RUNIN": [],
      "device.factory.end_FFT": [],
      "EVT": [],
      "DVT": [],
      "PVT": []
    },
    "waived_tests": {
      "EVT": [],
      "DVT": [],
      "PVT": []
    }
  },
  "definitions": {
    "SMTComponents": {
      "subtests": [
        "ProbeBluetooth",
        "SMTWifiSSIDList",
        "Battery",
        "BatterySysfs",
        "SMTStressAppTest",
        "SMTStressCountdown",
        "ChargerTypeDetection",
        "PartitionTable",
        "VerifyRootPartition"
      ]
    },
    "SMT": {
      "label": "SMT (Kelsier SMT Functions Test)",
      "locals": {
        "station_num": "SMT",
        "station_end_upload_report": true
      },
      "subtests": [
        "Start",
        "Barrier",
        "SMTStart",
        "SMTItems",
        "CheckPoint",
        "SMTEnd"
      ]
    },
    "SMTStart": {
      "inherit": "TestGroup",
      "label": "Prepare",
      "subtests": [
        "ECWPPinHigh",
        "Partitions2Protect",
        "WaitTi50",
        "UpdateTi50Firmware",
        "Barrier",
        "ReadDeviceDataFromVPD",
        "SMTDefineSKUID",
        "FullRebootStep",
        "SyncFactoryServer",
        "SMTScanMLB",
        "SMTScanOperatorID",
        "SMTScanStationID",
        "SetOEMName",
        "StationStart",
        "FullRebootStep",
        "ModelSKU",
        "WriteDeviceDataToVPD",
        "Barrier"
      ]
    },
    "SMTItems": {
      "inherit": "TestGroup",
      "subtests": [
        "KeyboardPowerButton",
        "CheckSecdataVersion",
        "SMTComponents",
        "SMTKelsierProbe",
        "SMTThermalLoad",
        "FrontCamera",
        "LEDBattery",
        "Bluetooth",
        {
          "inherit": "WifiSSIDList",
          "args": {
            "event_log_name": "SMT_basic_ssid_list"
          }
        },
        "ThermalSensors",
        "LidSwitch",
        "SMTCheckMem",
        "SMTKeyboard",
        "Touchpad",
        "KeyboardBacklight",
        "SpeakerDMic",
        "AudioJack",
        "KaladinFan",
        "USBTypeAManualBase",
        "USBTypeCManualTestGroup",
        "USBTypeCManualChargeGroup"
      ]
    },
    "SMTEnd": {
      "inherit": "TestGroup",
      "label": "Finish",
      "subtests": [
        "SMTUploadRegCodes",
        "CheckRegCodeForSMT",
        "ProbeDeviceInfo",
        "CheckBoardID",
        "StationEnd",
        "Cr50SMTWriteFlashInfo",
        "SMTDefaultSKUID",
        "CheckPoint",
        "DeleteToolkit",
        "HaltStep"
      ]
    },
    "StationStart": {
      "inherit": "FlattenGroup",
      "subtests": [
        "SyncFactoryServer",
        "Barrier",
        "ShopfloorNotifyStart"
      ]
    },
    "ShopfloorService": {
      "pytest_name": "shopfloor_service",
      "run_if": "constants.enable_factory_server"
    },
    "FAT": {
      "locals": {
        "station_num": "FAT"
      },
      "subtests": [
        "FATStart",
        "FATItems",
        "FATEnd",
        "RebootStep",
        "CheckPoint"
      ]
    },
    "FATStart": {
      "subtests": [
        "GetBatteryCT",
        "WriteEmptyMLBSN",
        "ECWPPinHigh",
        "Barrier",
        "CheckHaveFanOrNot",
        "Partitions2Protect",
        "WaitTi50",
        "UpdateTi50Firmware",
        "Barrier",
        "GetBatteryCT",
        "StationStart",
        "Partitions2Protect",
        "SettingCBIFromSF",
        "RebootStep",
        "KelsierCustomerTag",
        "FullRebootStep",
        "CBIWriteGroup",
        "UpdateFirmwareTest",
        "Barrier",
        "CopyManifestFromRelease",
        "KelsierCopyManifestToCME",
        "CopyISHFWTolib",
        "ModelSKU",
        "ReadDeviceDataFromVPD",
        "CheckHaveFanOrNot",
        "SyncFactoryServer",
        "CheckReleaseImage",
        "WriteDeviceDataToVPD",
        "SpeakerDMic",
        "Bluetooth",
        "Barrier"
      ]
    },
    "HardwareTest": {
      "parallel": true,
      "subtests": [
        "PartitionTable",
        "VerifyRootPartition",
        "BatterySysfs",
        "Battery",
        "ThermalSensors",
        "MemorySize"
      ]
    },
    "FATItems": {
      "subtests": [
        "ST5Uniformity",
        "CopyGSCTool",
        "HWID",
        "HardwareCheck",
        "CheckRegCode",
        "SMTKelsierProbe",
        "CopyIntelWiFiSar",
        "CopyISHFWTolib",
        "HardwareTest",
        {
          "inherit": "WifiSSIDList",
          "args": {
            "event_log_name": "FAT_basic_ssid_list"
          }
        },
        "ReadEDIDInfo",
        "Wireless",
        "CopyMiniOS",
        "CheckBatteryCapacity",
        "Barrier"
      ]
    },
    "FFT": {
      "locals": {
        "station_num": "FFT"
      },
      "subtests": [
        "FFTItems"
      ]
    },
    "FFTItems": {
      "subtests": [
        "CopyISHFWTolib",
        "FullRebootStep",
        "EnableLidSwitch",
        "LidSwitch",
        "DisplayPoint",
        "Display",
        "FAScanProdid",
        "FAScanSN",
        "CheckAllSN",
        "SetAttestID",
        "Keyboard",
        "KeyboardPowerButton",
        "AudioJack",
        "Backlight",
        "KeyboardBacklight",
        "LEDBattery",
        "FrontCameraLED",
        "Touchpad",
        "Touchscreen",
        "FrontCameraQRScan",
        "Barrier",
        "USBTypeAManualBase",
        "USBTypeCManualTestGroup",
        "USBTypeCManualChargeGroup",
        "HPRequestWeightTouchpad",
        "SpeakerDMic",
        "KaladinFan",
        "KelsierCopyManifestToCME",
        "CBXBrandedChassis",
        "NoCBXBrandedChassis",
        "CheckFeatureCompliance",
        "Barrier"
      ]
    },
    "RunIn": {
      "locals": {
        "station_num": "Runin"
      },
      "subtests": [
        "RunInItems",
        "CheckPoint",
        "StationEnd"
      ]
    },
    "RunInItems": {
      "subtests": [
        "CheckACState",
        "FullRebootStep",
        "BatterySysfs",
        "Battery",
        "ThemalTestGroup",
        "Barrier",
        "Idle",
        "ThemalTestWithWEBGLGroup",
        "Barrier",
        "ThermalSensors",
        "MRCCache",
        "Barrier",
        "PartitionTable",
        "BadBlocks",
        "Idle",
        "SubGroupRRTWarmReboot",
        "Idle",
        "RunInStressGroupWithFrontCamera",
        "RebootStep",
        "Barrier",
        "RunInWebGLAquarium",
        "RebootStep",
        "Delay30S",
        "IgnoreLTRCNV",
        "RRTDozingStress",
        "RebootStep",
        "Idle",
        "Barrier",
        "VerifyRootPartition",
        "HWID",
        "RunInBlockingCharge",
        "Barrier"
      ]
    },
    "GRT": {
      "inherit": "TestGroup",
      "label": "GRT (Google Required Tests)",
      "locals": {
        "station_end_upload_report": true
      },
      "subtests": [
        "GRTStart",
        "GRTItems",
        "GRTEnd",
        "FinalizeGroup"
      ]
    },
    "FinalizeGroup": {
      "label": "Finalize",
      "subtests": [
        "SyncFactoryServer",
        "KelsierCopyManifestToCME",
        "DeletePVTDLMSKUID",
        "ClearUnknownRWVPD",
        "CopyMiniOS",
        "PartitionTable",
        "AllCheckPoint",
        "GRTFinalizeNoCBX",
        "GRTFinalizeCBX"
      ]
    },
    "GRTItems": {
      "inherit": "FlattenGroup",
      "subtests": [
        "TPMVerifyAndClear",
        "GetIntelDescriptorStatus",
        "LockIntelDescriptor",
        "SyncFactoryServer",
        "CheckSecdataVersion",
        "ReSignReleaseKernel",
        "UploadRegCodes",
        "UploadSerialNumberForAuditing",
        "UploadZeroTouchIds",
        "CheckPoint",
        "HWID",
        "DisableLidSwitch",
        "Ti50APROVerification",
        "CheckPoint"
      ]
    },
    "StationEnd": {
      "inherit": "FlattenGroup",
      "subtests": [
        "StationEndSyncFactoryServer",
        "ShopfloorNotifyEnd",
        "Barrier",
        "WriteDeviceDataToVPD"
      ]
    },
    "ProbeBluetooth": {
      "inherit": "ExecShell",
      "label": "Probe Bluetooth",
      "args": {
        "commands": "lshw | grep -i Bluetooth"
      }
    },
    "TPMVerifyAndClear": {
      "retries": 5,
      "label": {
        "en-US":"TPMVerify And Clear",
        "zh-CN": "\u0054\u0050\u004d\u6d4b\u8bd5\u7fa4\u7ec4"
      },
      "subtests": [
        "TPMVerifyEK",
        "ClearTPMOwnerRequest",
        "RebootStep"
      ]
    },
    "UpdateCBI": {
      "pytest_name": "update_cbi",
      "label": "Update CBI",
      "args": {
        "enable_factory_server": false,
        "force": true,
        "program": "nissa",
        "project": "kaladin",
        "cbi_data_names": [
          "SKU_ID",
          "DRAM_PART_NUM"
        ]
      }
    },
    "LidSwitch": {
      "pytest_name": "lid_switch",
      "label": "Lid Switch",
      "args": {
        "timeout_secs": "eval! constants.default_timeout_secs",
	"device_filter": "Lid Switch"
      }
    },
    "KeyboardPowerButton": {
      "subtests": [
        {
          "inherit": "Button",
          "label": "Power Button",
          "args": {
            "button_key_name": "ectool:-GSC_EC_PWR_BTN_ODL",
            "button_name": "i18n! Power Button"
          }
        }
      ]
    },
    "Keyboard": {
      "args": {
        "timeout_secs": "eval! constants.default_timeout_secs",
        "has_numpad": false,
        "allow_multi_keys": true,
        "has_power_key": true,
        "skip_keycodes": [116]
      }
    },
    "KeyboardBacklight": {
      "pytest_name": "keyboard_backlight",
      "run_if": "device.component.has_keyboard_backlight"
    },
    "ECWPPinHigh": {
      "inherit": "ExecShell",
      "label": "EC WP Pin High",
      "args": {
        "commands": [
          "ectool gpioget EC_WP_ODL | tr ' ' '_' | grep GPIO_EC_WP_ODL_=_1"
        ]
      }
    },
    "ChargeDischargeCurrent": {
      "pytest_name": "battery_current",
      "label": "Charge Discharge Current",
      "exclusive_resources": [
        "POWER"
      ],
      "args": {
        "min_charging_current": null,
        "min_discharging_current": null,
        "current_difference": 400,
        "retry_times": 3,
        "max_battery_level": 90
      }
    },
    "Bluetooth": {
      "retries": 5,
      "args": {
        "prompt_scan_message": false
      }
    },
    "Delay30S": {
      "pytest_name": "exec_shell",
      "label": "Delay30S",
      "args": {
        "commands": [
          "sleep 30"
        ]
      }
    },
    "WaitTi50": {
      "pytest_name": "exec_shell",
      "label": "Wait for Ti50 Ready",
      "args": {
        "commands": [
          "while true; do if [ $(cat /proc/uptime |awk -F'.' '{print $1}') -lt 60 ]; then echo wait; sleep 5; else break; fi; done"
        ]
      }
    },
    "UpdateCBIGroup": {
      "subtests": [
        "SetCBIToDefault",
        "Barrier",
        "UpdateCBI",
        "Barrier",
        "FullRebootStep"
      ]
    },
    "SetOEMName": {
      "pytest_name": "exec_shell",
      "label": "SetOEMName (*)",
      "args": {
        "commands": [
          "ectool cbi set 4 HP 0",
          "factory device-data oem_name=HP"
        ]
      }
    },
    "Touchscreen": {
      "__replace__": true,
      "run_if": "device.component.has_touchscreen",
      "pytest_name": "touchscreen",
      "args": {
        "x_segments": 7,
        "timeout_secs": 2000000,
        "y_segments": 7
      }
    },
    "Touchpad": {
      "args": {
        "number_to_quadrant": 1,
        "number_to_click": 4,
        "x_segments": 3,
        "y_segments": 3,
        "timeout_secs": 2000000
      }
    },
    "BadBlocks": {
      "run_if": "not device.factory.my_ufs"
    },
    "USBTypeCManualTestGroup": {
      "inherit": "FlattenGroup",
      "subtests": [
        "USBTypeCManualUSB1",
        "USBTypeCManualUSB2",
        "USBTypeCManualDisplay"
      ]
    },
    "USBTypeCManualUSB1": {
      "inherit": "TestGroup",
      "parallel": true,
      "label": "TypeC USB",
      "layout": {
        "type": "tiled",
        "options": {
          "columns": 3
        }
      },
      "subtests": [
        "USB3CC1PerformanceMid",
        "USB3CC2PerformanceMid",
        "TypeCUSB2PerformanceMid"
      ]
    },
    "USBTypeCManualUSB2": {
      "inherit": "TestGroup",
      "parallel": true,
      "label": "TypeC USB",
      "layout": {
        "type": "tiled",
        "options": {
          "columns": 3
        }
      },
      "subtests": [
        "Idle",
        "USB3CC1PerformanceOut",
        "USB3CC2PerformanceOut",
        "TypeCUSB2PerformanceOut"
      ]
    },
    "USB3CC1PerformanceMid": {
      "retries": 5,
      "inherit": "USBPerformance",
      "label": "USB3 CC1 Performance (Mid)",
      "locals": {
        "usb": "eval! constants.typec_usb.left",
        "usb_label": "i18n! Left USB TypeC"
      },
      "args": {
        "timeout_secs": "eval! constants.default_timeout_secs",
        "sysfs_path": "eval! constants.typec_usb.left.usb3_sysfs_path",
        "usbpd_port_polarity": [
          "eval! locals.usb.usbpd_id",
          1
        ]
      }
    },
    "USB3CC2PerformanceMid": {
      "retries": 5,
      "inherit": "USBPerformance",
      "label": "USB3 CC2 Performance (Mid)",
      "locals": {
        "usb": "eval! constants.typec_usb.left",
        "usb_label": "i18n! Left USB TypeC"
      },
      "args": {
        "timeout_secs": "eval! constants.default_timeout_secs",
        "sysfs_path": "eval! constants.typec_usb.left.usb3_sysfs_path",
        "usbpd_port_polarity": [
          "eval! locals.usb.usbpd_id",
          2
        ]
      }
    },
    "TypeCUSB2PerformanceMid": {
      "retries": 5,
      "inherit": "USBPerformance",
      "label": "USB2 Performance (Mid)",
      "locals": {
        "usb": "eval! constants.typec_usb.left",
        "usb_label": "i18n! Left USB TypeC"
      },
      "args": {
        "timeout_secs": "eval! constants.default_timeout_secs",
        "sysfs_path": "eval! constants.typec_usb.left.usb2_sysfs_path"
      }
    },
    "USB3CC1PerformanceOut": {
      "retries": 5,
      "inherit": "USBPerformance",
      "run_if": "device.component.has_mother_board_usb_c==2",
      "label": "USB3 CC1 Performance (Out)",
      "locals": {
        "usb": "eval! constants.typec_usb.right",
        "usb_label": "i18n! Left USB TypeC"
      },
      "args": {
        "timeout_secs": "eval! constants.default_timeout_secs",
        "sysfs_path": "eval! constants.typec_usb.right.usb3_sysfs_path",
        "usbpd_port_polarity": [
          "eval! locals.usb.usbpd_id",
          1
        ]
      }
    },
    "USB3CC2PerformanceOut": {
      "retries": 5,
      "inherit": "USBPerformance",
      "run_if": "device.component.has_mother_board_usb_c==2",
      "label": "USB3 CC2 Performance (Out)",
      "locals": {
        "usb": "eval! constants.typec_usb.right",
        "usb_label": "i18n! Left USB TypeC"
      },
      "args": {
        "timeout_secs": "eval! constants.default_timeout_secs",
        "sysfs_path": "eval! constants.typec_usb.right.usb3_sysfs_path",
        "usbpd_port_polarity": [
          "eval! locals.usb.usbpd_id",
          2
        ]
      }
    },
    "TypeCUSB2PerformanceOut": {
      "retries": 5,
      "inherit": "USBPerformance",
      "run_if": "device.component.has_mother_board_usb_c==2",
      "label": "USB2 Performance (Out)",
      "locals": {
        "usb": "eval! constants.typec_usb.right",
        "usb_label": "i18n! Left USB TypeC"
      },
      "args": {
        "timeout_secs": "eval! constants.default_timeout_secs",
        "sysfs_path": "eval! constants.typec_usb.right.usb2_sysfs_path"
      }
    },
    "USBTypeCManualDisplay": {
      "label": "TypeC Display",
      "inherit": "TestGroup",
      "subtests": [
        "USBTypeCManualLeft2",
        "USBTypeCManualRight2"
      ]
    },
    "USBTypeCManualLeft2": {
      "retries": 5,
      "inherit": "USBTypeCManualBase3",
      "label": "Manual Test Left TypeC HDMI",
      "locals": {
        "usb": "eval! constants.typec_usb.left",
        "usb_label": "i18n! Left USB TypeC"
      }
    },
    "USBTypeCManualRight2": {
      "retries": 5,
      "inherit": "USBTypeCManualBase3",
      "run_if": "device.component.has_mother_board_usb_c==2",
      "label": "Manual Test Right TypeC HDMI",
      "locals": {
        "usb": "eval! constants.typec_usb.right",
        "usb_label": "i18n! Right USB TypeC"
      }
    },
    "USBTypeCManualBase3": {
      "inherit": "ExternalDisplay",
      "label": "USB3 External Display Test",
      "args": {
        "display_info": [
          "eval! locals.usb.display_info"
        ]
      }
    },
    "SyncFactoryServer": {
      "args": {
        "update_toolkit": true,
        "sync_event_logs": false,
        "update_without_prompt": true
      }
    },
    "USBTypeCManualChargeGroup": {
      "label": "TypeC Charge Group",
      "inherit": "TestGroup",
      "subtests": [
        "USBTypeCManualChargeLeft20V",
        "USBTypeCManualChargeRight20V"
      ]
    },
    "USBTypeCManualChargeLeft20V": {
      "retries": 5,
      "inherit": "USBTypeCManualCharge",
      "label": "20V Charging (Mid)",
      "locals": {
        "usb": "eval! constants.typec_usb.left",
        "usb_label": "i18n! Left USB TypeC",
        "voltage": 20
      }
    },
    "USBTypeCManualChargeRight20V": {
      "retries": 5,
      "inherit": "USBTypeCManualCharge",
      "run_if": "device.component.has_mother_board_usb_c==2",
      "label": "20V Charging (Out)",
      "locals": {
        "usb": "eval! constants.typec_usb.right",
        "usb_label": "i18n! Right USB TypeC",
        "voltage": 20
      }
    },
    "FFTAccel": {
      "inherit": "FactoryTest",
      "label": "Accelerometers test",
      "run_if": "device.component.has_tabletmode",
      "subtests": [
        "BaseAccelerometersCalibration",
        "LidAccelerometersCalibration",
        "AccelerometersLidAngle",
        "Barrier"
      ]
    },
    "BaseGyroscope": {
      "label": "Gyroscope",
      "run_if": "device.component.has_tabletmode",
      "subtests": [
        "GyroscopeCalibration",
        "Gyroscope"
      ]
    },
    "Gyroscope": {
      "pytest_name": "gyroscope",
      "label": "Gyroscope",
      "args": {
        "timeout_secs": 9999,
        "is_ish_enabled": true,
        "rotation_threshold": 1.0,
        "stop_threshold": 0.1
      }
    },
    "ScreenRotation": {
      "run_if": "device.component.has_tabletmode",
      "label": "Screen Rotation",
      "subtests": [
        {
          "pytest_name": "tablet_mode",
          "args": {
            "lid_filter": "Lid Switch",
            "timeout_secs": 9999,
            "prompt_flip_tablet": true
          }
        },
        {
          "pytest_name": "tablet_rotation",
          "label": "Tablet Rotation Accelerometers",
          "args": {
            "timeout_secs": 9999,
            "degrees_to_orientations": {
              "base": {
                "0": {
                  "in_accel_x": 0,
                  "in_accel_y": -1,
                  "in_accel_z": 0
                },
                "90": {
                  "in_accel_x": 1,
                  "in_accel_y": 0,
                  "in_accel_z": 0
                },
                "180": {
                  "in_accel_x": 0,
                  "in_accel_y": 1,
                  "in_accel_z": 0
                },
                "270": {
                  "in_accel_x": -1,
                  "in_accel_y": 0,
                  "in_accel_z": 0
                }
              },
              "lid": {
                "0": {
                  "in_accel_x": 0,
                  "in_accel_y": 1,
                  "in_accel_z": 0
                },
                "90": {
                  "in_accel_x": 1,
                  "in_accel_y": 0,
                  "in_accel_z": 0
                },
                "180": {
                  "in_accel_x": 0,
                  "in_accel_y": -1,
                  "in_accel_z": 0
                },
                "270": {
                  "in_accel_x": -1,
                  "in_accel_y": 0,
                  "in_accel_z": 0
                }
              }
            },
            "spec_offset": [
              1.5,
              1.5
            ]
          }
        },
        {
          "pytest_name": "tablet_mode",
          "label": "Notebook Mode",
          "args": {
            "timeout_secs": 9999,
            "lid_filter": "Lid Switch",
            "prompt_flip_notebook": true
          }
        }
      ]
    },
